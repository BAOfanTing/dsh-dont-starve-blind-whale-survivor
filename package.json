{
  "name": "dsh-dont-starve-blind-whale-survivor",
  "version": "0.12.0",
  "description": "大肥鱼饿不死（Blind Whale Survivor）：让 DeepSeek 不靠画面玩《饥荒联机版》的 DSH 插件。自带饥荒 Lua 模组（自动装进 mods）、本机 MCP 服务器和文件桥；在插件页里调端口、游戏目录、额外要求、攻略，可选创建一个只让选中会话加载游戏工具的会话预设，或在所有会话里提供一个精简的 dst 入口工具。",
  "license": "MIT",
  "author": "大肥鱼",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dont-starve-together",
    "dst",
    "mcp"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./bridge": "./lib/bridge.js",
    "./tools": "./lib/tools.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node tools/build-client.mjs",
    "test": "node --test --test-force-exit \"tests/**/*.test.mjs\"",
    "record": "node tools/session-recorder.mjs",
    "lint": "node tools/check-syntax.mjs",
    "check:docs": "node tools/check-tools-doc.mjs",
    "check:docs:fix": "node tools/check-tools-doc.mjs --write",
    "check:hygiene": "node tools/check-hygiene.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "commitlint": "commitlint",
    "autodev": "node tools/auto-dev-loop.mjs",
    "autodev:live": "node tools/auto-dev-loop.mjs --live",
    "analyze": "node tools/analyze-session.mjs",
    "e2e:tier1": "node tools/run-live-tier1.mjs"
  },
  "files": [
    "lib",
    "DontStarveWhaleSurvivor",
    "cordis.patch.yml",
    "docs/dsh-plugin.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "ajv": "^8.20.0",
    "fengari": "^0.1.5",
    "luaparse": "^0.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
