{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blind-whale-survivor/schema/state.schema.json",
  "title": "Blind Whale Survivor State Contract (bws.state/1)",
  "description": "Game state contract shared by Lua observe.lua (WireEnvelope) and Node lib/state/snapshot.js (NormalizedState).",
  "oneOf": [
    { "$ref": "#/$defs/NormalizedState" },
    { "$ref": "#/$defs/WireEnvelope" }
  ],
  "$defs": {
    "NullableString": { "type": ["string", "null"] },
    "NullableNumber": { "type": ["number", "null"] },
    "NullableBoolean": { "type": ["boolean", "null"] },
    "StatBlock": {
      "type": ["object", "null"],
      "properties": {
        "current": { "type": "number" },
        "max": { "type": "number" },
        "percent": { "type": ["number", "null"] }
      }
    },
    "Item": {
      "type": "object",
      "required": ["prefab", "count"],
      "properties": {
        "prefab": { "type": "string" },
        "name": { "type": "string" },
        "count": { "type": "number", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "slot": { "type": "integer", "minimum": 1 },
        "slot_key": { "type": "string" },
        "food": { "type": "boolean" },
        "in_container": { "type": "boolean" }
      }
    },
    "EquipmentWornEntry": {
      "type": "object",
      "required": ["key", "item"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "item": { "$ref": "#/$defs/Item" }
      }
    },
    "Inventory": {
      "type": ["object", "null"],
      "required": ["slots", "used", "is_full", "items"],
      "properties": {
        "slots": { "type": "integer", "minimum": 0 },
        "used": { "type": "integer", "minimum": 0 },
        "is_full": { "type": "boolean" },
        "items": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/Item" } },
            { "type": "object", "maxProperties": 0 }
          ]
        }
      }
    },
    "Equipment": {
      "type": ["object", "null"],
      "properties": {
        "slots": {
          "type": "object",
          "properties": {
            "hands": { "oneOf": [{ "$ref": "#/$defs/Item" }, { "type": "null" }] },
            "head": { "oneOf": [{ "$ref": "#/$defs/Item" }, { "type": "null" }] },
            "body": { "oneOf": [{ "$ref": "#/$defs/Item" }, { "type": "null" }] }
          }
        },
        "worn": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/EquipmentWornEntry" } },
            { "type": "object" }
          ]
        }
      }
    },
    "Player": {
      "type": ["object", "null"],
      "properties": {
        "health": { "$ref": "#/$defs/StatBlock" },
        "hunger": { "$ref": "#/$defs/StatBlock" },
        "sanity": { "$ref": "#/$defs/StatBlock" },
        "in_light": { "type": "boolean" },
        "temperature": {
          "type": ["object", "null"],
          "properties": { "value": { "type": "number" } }
        },
        "wetness": {
          "type": ["object", "null"],
          "properties": { "value": { "type": "number" } }
        },
        "inventory": { "$ref": "#/$defs/Inventory" },
        "equipment": { "$ref": "#/$defs/Equipment" }
      }
    },
    "World": {
      "type": ["object", "null"],
      "properties": {
        "status": { "type": "string" },
        "day": { "type": "integer", "minimum": 1 },
        "season": { "type": "string" },
        "season_name": { "type": "string" },
        "phase": { "type": "string" },
        "phase_name": { "type": "string" },
        "world_temperature": { "type": "number" },
        "is_cave": { "type": "boolean" },
        "weather": {
          "type": "object",
          "properties": {
            "is_raining": { "type": "boolean" },
            "is_snowing": { "type": "boolean" },
            "is_full_moon": { "type": "boolean" },
            "is_winter": { "type": "boolean" }
          }
        },
        "world_configuration": { "type": ["object", "null"] }
      }
    },
    "NearbyEntity": {
      "type": "object",
      "required": ["prefab"],
      "properties": {
        "ref": { "type": "string" },
        "handle": { "type": "string" },
        "prefab": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "name": { "type": "string" },
        "distance": { "type": "number", "minimum": 0 },
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "health": { "type": "number" },
        "max_health": { "type": "number" },
        "work_action": { "type": "string" },
        "stack_size": { "type": "integer" },
        "harvest_ready": { "type": "boolean" },
        "is_burning": { "type": "boolean" },
        "is_burnt": { "type": "boolean" },
        "fuel_percent": { "type": "number" },
        "targeting_you": { "type": "boolean" },
        "stewer": { "type": "object" }
      }
    },
    "Nearby": {
      "type": ["object", "null"],
      "properties": {
        "runtime_id": { "$ref": "#/$defs/NullableString" },
        "snapshot_id": { "$ref": "#/$defs/NullableString" },
        "status": { "type": "string" },
        "radius": { "type": "number" },
        "scan_seconds": { "type": "number" },
        "total_found": { "type": "integer", "minimum": 0 },
        "total_returned": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "error": { "type": "string" },
        "scan": { "type": "object" },
        "buckets": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "$ref": "#/$defs/NearbyEntity" }
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": { "type": "string" },
                  "label": { "type": "string" },
                  "items": { "type": "array", "items": { "$ref": "#/$defs/NearbyEntity" } }
                }
              }
            }
          ]
        },
        "delta": { "type": "object" }
      }
    },
    "WireIdentity": {
      "type": "object",
      "properties": {
        "session_id": { "$ref": "#/$defs/NullableString" },
        "cluster_id": { "$ref": "#/$defs/NullableString" },
        "cluster_id_source": { "type": "string" },
        "shard_id": { "$ref": "#/$defs/NullableString" },
        "world_key": { "type": "string" },
        "world_key_source": { "type": "string" }
      }
    },
    "NormalizedIdentity": {
      "type": "object",
      "required": ["sessionId", "clusterId", "clusterIdSource", "shardId", "worldKey", "worldKeySource"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/NullableString" },
        "clusterId": { "$ref": "#/$defs/NullableString" },
        "clusterIdSource": { "type": "string" },
        "shardId": { "$ref": "#/$defs/NullableString" },
        "worldKey": { "$ref": "#/$defs/NullableString" },
        "worldKeySource": { "type": "string" }
      }
    },
    "WireActor": {
      "type": ["object", "null"],
      "required": ["actor_id", "valid", "alive", "is_ghost"],
      "properties": {
        "actor_id": { "type": "string" },
        "actor_id_kind": { "type": "string" },
        "actor_type": { "type": "string" },
        "prefab": { "$ref": "#/$defs/NullableString" },
        "name": { "$ref": "#/$defs/NullableString" },
        "valid": { "type": "boolean" },
        "alive": { "type": "boolean" },
        "is_ghost": { "type": "boolean" },
        "missing_components": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "object", "maxProperties": 0 }
          ]
        },
        "guid": { "type": ["integer", "string", "null"] },
        "tile_x": { "$ref": "#/$defs/NullableNumber" },
        "tile_z": { "$ref": "#/$defs/NullableNumber" },
        "x": { "$ref": "#/$defs/NullableNumber" },
        "y": { "$ref": "#/$defs/NullableNumber" },
        "z": { "$ref": "#/$defs/NullableNumber" }
      }
    },
    "NormalizedActor": {
      "type": ["object", "null"],
      "required": ["actorId", "actorIdKind", "actorType", "valid", "alive", "isGhost", "missingComponents"],
      "properties": {
        "actorId": { "$ref": "#/$defs/NullableString" },
        "actorIdKind": { "type": "string" },
        "actorType": { "type": "string" },
        "prefab": { "$ref": "#/$defs/NullableString" },
        "name": { "$ref": "#/$defs/NullableString" },
        "valid": { "type": "boolean" },
        "alive": { "type": "boolean" },
        "isGhost": { "type": "boolean" },
        "missingComponents": { "type": "array", "items": { "type": "string" } },
        "tileX": { "$ref": "#/$defs/NullableNumber" },
        "tileZ": { "$ref": "#/$defs/NullableNumber" },
        "x": { "$ref": "#/$defs/NullableNumber" },
        "y": { "$ref": "#/$defs/NullableNumber" },
        "z": { "$ref": "#/$defs/NullableNumber" }
      }
    },
    "WireObserver": {
      "type": "object",
      "required": ["snapshot_id", "sequence", "status"],
      "properties": {
        "snapshot_id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "timestamp": { "type": "number" },
        "sampled_at": { "type": "number" },
        "sample_age_ms": { "type": "number" },
        "reused": { "type": "boolean" },
        "status": { "type": "string" },
        "errors": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "object", "maxProperties": 0 }
          ]
        },
        "unavailable_fields": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "object", "maxProperties": 0 }
          ]
        },
        "schema": { "type": "string", "const": "bws.state/1" }
      }
    },
    "NormalizedObserver": {
      "type": "object",
      "required": ["snapshotId", "sequence", "status", "errors", "unavailableFields"],
      "properties": {
        "snapshotId": { "$ref": "#/$defs/NullableString" },
        "sequence": { "$ref": "#/$defs/NullableNumber" },
        "status": { "type": "string" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "unavailableFields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "NormalizedDangerZone": {
      "type": "object",
      "required": ["x", "z", "radius", "source", "ageS", "ttlS"],
      "properties": {
        "x": { "$ref": "#/$defs/NullableNumber" },
        "z": { "$ref": "#/$defs/NullableNumber" },
        "radius": { "type": "number" },
        "source": { "type": "string" },
        "ageS": { "type": "number" },
        "ttlS": { "type": "number" }
      }
    },
    "WireData": {
      "type": "object",
      "required": ["schema", "observer"],
      "properties": {
        "schema": { "type": "string", "const": "bws.state/1" },
        "identity": { "$ref": "#/$defs/WireIdentity" },
        "actor": { "$ref": "#/$defs/WireActor" },
        "player": { "$ref": "#/$defs/Player" },
        "world": { "$ref": "#/$defs/World" },
        "nearby": { "$ref": "#/$defs/Nearby" },
        "character": { "type": ["object", "null"] },
        "companion": { "type": ["object", "null"] },
        "combat": { "type": ["object", "null"] },
        "quest_guide": { "type": ["object", "null"] },
        "danger_zones": { "type": "array" },
        "warnings": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "object", "maxProperties": 0 }
          ]
        },
        "reflex": { "type": ["object", "null"] },
        "observer": { "$ref": "#/$defs/WireObserver" },
        "ready": { "type": "boolean" },
        "dead": { "type": "boolean" },
        "players": { "type": "integer", "minimum": 0 },
        "tick": { "type": "integer", "minimum": 0 },
        "mastersim": { "type": "boolean" },
        "x": { "$ref": "#/$defs/NullableNumber" },
        "z": { "$ref": "#/$defs/NullableNumber" },
        "day": { "$ref": "#/$defs/NullableNumber" },
        "phase": { "$ref": "#/$defs/NullableString" }
      }
    },
    "WireEnvelope": {
      "type": "object",
      "required": ["ready", "text", "data"],
      "properties": {
        "v": { "type": "integer" },
        "seq": { "type": "integer", "minimum": 0 },
        "t": { "type": "number" },
        "mod": { "type": "string" },
        "build": { "type": "string" },
        "ready": { "type": "boolean" },
        "text": { "type": "string" },
        "data": { "$ref": "#/$defs/WireData" }
      }
    },
    "NormalizedState": {
      "type": "object",
      "required": [
        "schema",
        "ok",
        "status",
        "identity",
        "actor",
        "observer",
        "errors",
        "unavailableFields",
        "dangerZones",
        "warnings",
        "text",
        "textSource",
        "stale"
      ],
      "properties": {
        "schema": { "type": "string", "const": "bws.state/1" },
        "ok": { "type": "boolean" },
        "status": { "type": "string" },
        "sequence": { "$ref": "#/$defs/NullableNumber" },
        "snapshotId": { "$ref": "#/$defs/NullableString" },
        "observedAt": { "$ref": "#/$defs/NullableNumber" },
        "sampledAt": { "$ref": "#/$defs/NullableNumber" },
        "reused": { "type": "boolean" },
        "sampleAgeMs": { "$ref": "#/$defs/NullableNumber" },
        "mod": { "$ref": "#/$defs/NullableString" },
        "build": { "$ref": "#/$defs/NullableString" },
        "identity": { "$ref": "#/$defs/NormalizedIdentity" },
        "actor": { "$ref": "#/$defs/NormalizedActor" },
        "player": { "$ref": "#/$defs/Player" },
        "world": { "$ref": "#/$defs/World" },
        "nearby": { "$ref": "#/$defs/Nearby" },
        "character": { "type": ["object", "null"] },
        "companion": { "type": ["object", "null"] },
        "combat": { "type": ["object", "null"] },
        "quest_guide": { "type": ["object", "null"] },
        "dangerZones": {
          "type": "array",
          "items": { "$ref": "#/$defs/NormalizedDangerZone" }
        },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "reflex": { "type": ["object", "null"] },
        "observer": { "$ref": "#/$defs/NormalizedObserver" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "unavailableFields": { "type": "array", "items": { "type": "string" } },
        "players": { "$ref": "#/$defs/NullableNumber" },
        "mastersim": { "$ref": "#/$defs/NullableBoolean" },
        "text": { "type": "string" },
        "textSource": { "type": "string", "enum": ["lua", "legacy", "none"] },
        "ageMs": { "$ref": "#/$defs/NullableNumber" },
        "stale": { "type": "boolean" },
        "path": { "$ref": "#/$defs/NullableString" },
        "serverNow": { "type": "number" }
      }
    }
  }
}
