{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blind-whale-survivor/schema/state.schema.json",
  "title": "Blind Whale Survivor · Phase 1 日志契约（schema_version = 1）",
  "description": "游戏日志里每条 [BWS] 记录都是下面三种之一（oneOf）。Bridge 把同一 session + tick 的 state 与 nearby 合并成 $defs.GameState 对外服务。",
  "oneOf": [
    {
      "$ref": "#/$defs/Boot"
    },
    {
      "$ref": "#/$defs/State"
    },
    {
      "$ref": "#/$defs/Nearby"
    }
  ],
  "$defs": {
    "Header": {
      "type": "object",
      "description": "所有记录共有的头部字段",
      "required": [
        "schema_version",
        "type",
        "phase",
        "observer_version",
        "side",
        "shard"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "phase": {
          "type": "integer",
          "const": 1
        },
        "observer_version": {
          "type": "string"
        },
        "side": {
          "type": "string",
          "enum": [
            "server",
            "client",
            "unknown"
          ]
        },
        "shard": {
          "type": "string",
          "enum": [
            "master",
            "caves",
            "unknown"
          ]
        },
        "session": {
          "type": "string",
          "description": "TheNet:GetSessionIdentifier()，分片各自不同"
        },
        "t": {
          "type": "integer",
          "description": "unix 秒（os.time）"
        },
        "rt": {
          "type": "number",
          "description": "真实时间秒（TheSim:GetRealTime()/1000）"
        },
        "sim_tick": {
          "type": "integer",
          "description": "模拟 tick（TheSim:GetTick()），服务器暂停时不涨"
        },
        "last_error": {
          "type": "string"
        }
      }
    },
    "Boot": {
      "type": "object",
      "required": [
        "type",
        "mod",
        "ismastersim",
        "interval",
        "players"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "boot"
        },
        "mod": {
          "type": "string"
        },
        "ismastersim": {
          "type": "boolean"
        },
        "interval": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 30
        },
        "players": {
          "type": "object",
          "required": [
            "count"
          ],
          "properties": {
            "count": {
              "type": "integer"
            }
          }
        }
      }
    },
    "State": {
      "type": "object",
      "description": "每 OBSERVER_INTERVAL 秒一条；故意不含实体（日志单行有长度上限）。tick 可与 nearby.tick 配对。",
      "required": [
        "type",
        "observer"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "state"
        },
        "tick": {
          "type": "integer",
          "minimum": 1,
          "description": "周期编号。0.6.0+ 在顶层；更早的版本在 observer.tick，Bridge 用 record.tick ?? record.observer.tick 归一化"
        },
        "player": {
          "$ref": "#/$defs/Player"
        },
        "inventory": {
          "$ref": "#/$defs/Inventory"
        },
        "world": {
          "$ref": "#/$defs/World"
        },
        "observer": {
          "$ref": "#/$defs/Observer"
        }
      },
      "not": {
        "required": [
          "entities"
        ]
      }
    },
    "Nearby": {
      "type": "object",
      "description": "每 OBSERVER_SCAN_SECONDS 扫一次，单独一条；tick 与同周期的 state 相同",
      "required": [
        "type",
        "radius_tiles",
        "scanned",
        "returned",
        "counts",
        "scanned_at_tick"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "nearby"
        },
        "tick": {
          "type": "integer",
          "minimum": 1
        },
        "radius_tiles": {
          "type": "number",
          "minimum": 2,
          "maximum": 40
        },
        "scanned": {
          "type": "integer",
          "minimum": 0
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean",
          "description": "因每类/总数上限被截断"
        },
        "trimmed": {
          "type": "boolean",
          "description": "因日志长度预算被裁剪"
        },
        "oversize": {
          "type": "boolean"
        },
        "scanned_at_tick": {
          "type": "integer",
          "minimum": 1
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "entities": {
          "type": "array",
          "description": "预算不够被完全裁掉时不出现（配 oversize:true / returned:0）；Bridge 归一化成 []。",
          "items": {
            "$ref": "#/$defs/Entity"
          }
        }
      }
    },
    "Entity": {
      "type": "object",
      "required": [
        "prefab",
        "category",
        "tile_x",
        "tile_z",
        "distance"
      ],
      "properties": {
        "prefab": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "player",
            "hostile",
            "creature",
            "tree",
            "rock",
            "diggable",
            "damageable",
            "harvestable",
            "item",
            "structure"
          ]
        },
        "tile_x": {
          "type": "integer"
        },
        "tile_z": {
          "type": "integer"
        },
        "distance": {
          "type": "number",
          "minimum": 0
        },
        "hp": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "work_left": {
          "type": "number",
          "minimum": 0
        },
        "slot": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Item": {
      "type": "object",
      "required": [
        "prefab",
        "count"
      ],
      "properties": {
        "prefab": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "slot": {
          "type": "integer",
          "minimum": 1
        },
        "uses_left": {
          "type": "number"
        },
        "uses_max": {
          "type": "number"
        },
        "freshness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "fuel": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "armor": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "Inventory": {
      "type": "object",
      "required": [
        "slots",
        "used",
        "items"
      ],
      "properties": {
        "slots": {
          "type": "integer",
          "minimum": 1
        },
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "is_full": {
          "type": "boolean"
        },
        "items": {
          "description": "Lua 空表会被编码成 {}，Bridge 需要把 {} 归一化成 []。",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Item"
              }
            },
            {
              "type": "object",
              "maxProperties": 0
            }
          ]
        },
        "equipment": {
          "type": "object",
          "properties": {
            "hands": {
              "$ref": "#/$defs/Item"
            },
            "head": {
              "$ref": "#/$defs/Item"
            },
            "body": {
              "$ref": "#/$defs/Item"
            }
          }
        }
      }
    },
    "StatBlock": {
      "type": "object",
      "properties": {
        "current": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "dead": {
          "type": "boolean"
        }
      }
    },
    "Player": {
      "type": "object",
      "required": [
        "valid"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "prefab": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "guid": {
          "type": "integer"
        },
        "userid": {
          "type": "string"
        },
        "is_ghost": {
          "type": "boolean"
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "z",
            "tile_x",
            "tile_z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "tile_x": {
              "type": "integer"
            },
            "tile_z": {
              "type": "integer"
            }
          }
        },
        "health": {
          "$ref": "#/$defs/StatBlock"
        },
        "hunger": {
          "$ref": "#/$defs/StatBlock"
        },
        "sanity": {
          "$ref": "#/$defs/StatBlock"
        },
        "temperature": {
          "type": "object",
          "properties": {
            "current": {
              "type": "number"
            }
          }
        },
        "moisture": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "World": {
      "type": "object",
      "properties": {
        "prefab": {
          "type": "string"
        },
        "shard": {
          "type": "string",
          "enum": [
            "master",
            "caves"
          ]
        },
        "cycles": {
          "type": "integer",
          "minimum": 0,
          "description": "TheWorld.state.cycles（0 基）"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "description": "cycles + 1，玩家看到的天数"
        },
        "phase": {
          "type": "string",
          "enum": [
            "day",
            "dusk",
            "night"
          ]
        },
        "is_day": {
          "type": "boolean"
        },
        "is_dusk": {
          "type": "boolean"
        },
        "is_night": {
          "type": "boolean"
        },
        "season": {
          "type": "string",
          "enum": [
            "autumn",
            "winter",
            "spring",
            "summer"
          ]
        },
        "is_autumn": {
          "type": "boolean"
        },
        "is_winter": {
          "type": "boolean"
        },
        "is_spring": {
          "type": "boolean"
        },
        "is_summer": {
          "type": "boolean"
        },
        "elapsed_days_in_season": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_days_in_season": {
          "type": "integer",
          "minimum": 0
        },
        "season_progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "temperature": {
          "type": "number"
        },
        "time": {
          "type": "object",
          "properties": {
            "of_day": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "in_phase": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "weather": {
          "type": "object",
          "properties": {
            "is_raining": {
              "type": "boolean"
            },
            "precipitation": {
              "type": "number",
              "minimum": 0
            },
            "precipitation_rate": {
              "type": "number",
              "minimum": 0
            },
            "wetness": {
              "type": "number",
              "minimum": 0
            },
            "is_wet": {
              "type": "boolean"
            },
            "is_snowing": {
              "type": "boolean"
            },
            "snow_level": {
              "type": "number",
              "minimum": 0
            },
            "is_snow_covered": {
              "type": "boolean"
            },
            "is_acid_raining": {
              "type": "boolean"
            }
          }
        },
        "moon": {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string"
            },
            "is_full_moon": {
              "type": "boolean"
            },
            "is_new_moon": {
              "type": "boolean"
            },
            "is_waxing_moon": {
              "type": "boolean"
            }
          }
        },
        "cave": {
          "type": "object",
          "description": "只有 caves 分片才有",
          "properties": {
            "phase": {
              "type": "string"
            },
            "is_day": {
              "type": "boolean"
            },
            "is_dusk": {
              "type": "boolean"
            },
            "is_night": {
              "type": "boolean"
            },
            "moon_phase": {
              "type": "string"
            }
          }
        }
      }
    },
    "Observer": {
      "type": "object",
      "required": [
        "interval",
        "errors",
        "players"
      ],
      "properties": {
        "interval": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 30
        },
        "tick": {
          "type": "integer",
          "minimum": 1
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "string"
        },
        "last_error": {
          "type": "string"
        },
        "players": {
          "type": "object",
          "required": [
            "count"
          ],
          "properties": {
            "count": {
              "type": "integer"
            }
          }
        },
        "problems": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "GameState": {
      "type": "object",
      "description": "Bridge 把同 session + tick 的 state 与 nearby 合并后对外的规范结构",
      "required": [
        "schema_version",
        "timestamp",
        "side",
        "shard",
        "tick",
        "observer"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "timestamp": {
          "type": "object",
          "properties": {
            "unix": {
              "type": "integer"
            },
            "real_s": {
              "type": "number"
            },
            "sim_tick": {
              "type": "integer"
            }
          }
        },
        "session": {
          "type": "string"
        },
        "side": {
          "type": "string",
          "enum": [
            "server",
            "client",
            "unknown"
          ]
        },
        "shard": {
          "type": "string",
          "enum": [
            "master",
            "caves",
            "unknown"
          ]
        },
        "tick": {
          "type": "integer",
          "minimum": 1
        },
        "player": {
          "$ref": "#/$defs/Player"
        },
        "inventory": {
          "$ref": "#/$defs/Inventory"
        },
        "world": {
          "$ref": "#/$defs/World"
        },
        "nearby": {
          "$ref": "#/$defs/NearbySection"
        },
        "observer": {
          "$ref": "#/$defs/Observer"
        }
      }
    },
    "NearbySection": {
      "type": "object",
      "description": "nearby 段（GameState 里的形状；wire 记录见 $defs/Nearby）",
      "required": [
        "radius_tiles",
        "entities"
      ],
      "properties": {
        "radius_tiles": {
          "type": "number",
          "minimum": 2,
          "maximum": 40
        },
        "scanned": {
          "type": "integer",
          "minimum": 0
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "trimmed": {
          "type": "boolean"
        },
        "scanned_at_tick": {
          "type": "integer",
          "minimum": 1
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entity"
          }
        }
      }
    }
  }
}
