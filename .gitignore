# macOS/Linux 也能用同样的思路，但脚本是给 Windows 写的
node_modules/
tests/node_modules/
*.log
local.ps1

# 临时文件（提交信息、调试脚本、安装中文件）不进仓库
.msg*.txt
.commit-msg.txt
tmp-*
.tmp*
.install-mod.mjs
*.dbg.mjs

# 本机运行期产物 / 生成物
.runtime/
tests/artifacts/
DontStarveWhaleSurvivor/bws_config.lua
# 插件内置会话日志（每次覆盖写，只保留最新一次；不入库）
latestLogs/

# 归档目录里的依赖与构建产物一律不入库
# （M2.2.1：A 栈的 bridge / game-bridge / mcp-server / agent / survival 已移到 archive/legacy-*，
#   旧的顶层路径规则随之删除；现在统一用下面两条覆盖）
archive/**/node_modules/
archive/**/dist/
